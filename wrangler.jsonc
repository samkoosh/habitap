// HabiTap site on Cloudflare Workers (static assets only, no server code).
// Connect this repo in the Cloudflare dashboard (Workers & Pages → Create → Import a repository).
// Every branch push gets a preview URL; pushes to main go to production.
{
  "name": "habitap",
  "compatibility_date": "2025-06-01",
  "preview_urls": true,
  "workers_dev": true,
  // needed by `wrangler preview`, which Workers Builds runs for non-production branches
  "previews": {},
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
